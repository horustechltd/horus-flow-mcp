FLOW_HOST=0.0.0.0
FLOW_PORT=8011

# API key slots. Each slot has a key and a tier:
#   demo | free | mcp_public | builder | trader | pro | ultra | institutional | mega | admin
# The demo key is public (website dashboard) and is rate-limited per client IP.
FLOW_API_KEY_1=replace-with-public-demo-key
FLOW_API_TIER_1=demo
FLOW_API_KEY_2=replace-with-random-internal-service-key
FLOW_API_TIER_2=admin
FLOW_API_KEY_3=replace-with-random-hosted-mcp-key
FLOW_API_TIER_3=mcp_public

# Internal services (edge proof, QVE, hourly pulse) use this key
FLOW_API_KEY=same-value-as-the-internal-service-key
# Hosted MCP server (port 8012) uses this key
FLOW_MCP_KEY=same-value-as-the-hosted-mcp-key

APCA_API_KEY_ID=your-alpaca-key-id
APCA_API_SECRET_KEY=your-alpaca-secret

RAPIDAPI_PROXY_SECRET=your-rapidapi-proxy-secret

# Ops alerts (Telegram private chat id)
OPS_TELEGRAM_CHAT_ID=
